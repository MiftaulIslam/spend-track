# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker Postgres. Swap for a Neon pooled connection string in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/spendtrack?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/spendtrack?sslmode=require"

# ─── Auth ────────────────────────────────────────────────────────────────────
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
AI_MODEL_CHAT="claude-sonnet-5"
AI_MODEL_FAST="claude-haiku-4-5"
AI_MODEL_DEEP="claude-opus-5"

# ─── Jobs ────────────────────────────────────────────────────────────────────
JOBS_SECRET=""

# ─── Storage ─────────────────────────────────────────────────────────────────
# "local" writes under .storage/ ; "s3" uses the S3_* variables.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".storage"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NODE_ENV="development"
